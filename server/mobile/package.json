{
  "name": "@xmark/mobile-server",
  "version": "0.1.0",
  "description": "XMark mobile server — read-only access to workspace groups for the iPhone reader over Tailscale.",
  "private": true,
  "type": "module",
  "bin": {
    "xmark-mobile-server": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
